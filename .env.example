# Placeholders only; do not commit real API keys.
# IBM COS (existing inventory produced by Job 1)
COS_ENDPOINT=https://s3.eu-de.cloud-object-storage.appdomain.cloud
COS_BUCKET=YOUR_COS_BUCKET
COS_OBJECT_KEY=inventario_langfuse.json
COS_SERVICE_INSTANCE_ID=YOUR_COS_SERVICE_INSTANCE_CRN
COS_API_KEY=REPLACE_WITH_SECRET

# Governance Console as a Service / OpenPages REST v2
OP_BASE_URL=https://YOUR_GOVERNANCE_FIXED_URL
OP_API_KEY=REPLACE_WITH_SECRET
OP_PRIMARY_PARENT_ID=YOUR_BUSINESS_ENTITY_RESOURCE_ID

# Safety: 'check' is read-only, 'apply' creates objects
IMPORT_MODE=check
# Optional selection (leave empty for all agents)
IMPORT_ONLY_AGENT=
IMPORT_MAX_AGENTS=0
